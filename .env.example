# Port published on the Docker host. The container itself always uses 3000.
APP_PORT=3000

# A long random password used only by the admin dashboard and its API.
# Example: openssl rand -hex 32
ADMIN_TOKEN="replace-with-a-long-random-secret"

# Secret random path for admin dashboard (e.g. /admin-bb591658d3) to avoid player guessing /admin
ADMIN_PATH="/admin-bb591658d3"
VITE_ADMIN_PATH="/admin-bb591658d3"


# Create a named tunnel in Cloudflare Zero Trust and paste its token here.
# Configure public hostname nextfest.qtitpc.cyou -> http://nextfest:3000.
CLOUDFLARE_TUNNEL_TOKEN=""
